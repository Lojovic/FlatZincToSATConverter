#!/usr/bin/env bash

set -Eeuo pipefail

# Error handling

die() {
    echo "ERROR: $1" >&2
    exit 1
}

# Input

EXPORT_PROOF=0

if [ $# -eq 2 ] && [ "$1" = "-export-proof" ]; then
    EXPORT_PROOF=1
    shift
elif [ $# -ne 1 ]; then
    die "Usage: $0 [-export-proof] model.fzn"
fi

INPUT_FZN="$1"
[ -f "$INPUT_FZN" ] || die "Input file does not exist: $INPUT_FZN"

INPUT_DIR="$(cd "$(dirname "$INPUT_FZN")" && pwd)"
INPUT_BASE="$(basename "$INPUT_FZN" .fzn)"

# Files/constants

WORK_FZN="${INPUT_DIR}/${INPUT_BASE}_work.fzn"
BOUND_ANN="OPT_BOUND"

# Cleanup

cleanup() {
    rm -f \
        "${INPUT_DIR}/${INPUT_BASE}_satisfy.fzn" \
        "${INPUT_DIR}/${INPUT_BASE}_work.fzn" \
        "${INPUT_DIR}/${INPUT_BASE}.opt" \
        "${INPUT_DIR}/${INPUT_BASE}.best" \
        "${INPUT_DIR}/${INPUT_BASE}.proof" \
        "${INPUT_DIR}/${INPUT_BASE}.optmap" \
        "${INPUT_DIR}/${INPUT_BASE}.base.cnf" \
        "${INPUT_DIR}/${INPUT_BASE}.base.body.cnf" \
        formula.cnf \
        model.out
}
trap cleanup EXIT

# Parse solve goal 

RAW_SOLVE_LINE=$(grep -E '^solve[[:space:]]' "$INPUT_FZN" || true)
[ -n "$RAW_SOLVE_LINE" ] || die "No solve goal found in $INPUT_FZN"

CORE_SOLVE=$(echo "$RAW_SOLVE_LINE" \
    | sed -E 's/^solve[[:space:]]+.*[[:space:]]+(satisfy|minimize|maximize)[[:space:]]+/\1 /')

OPT_TYPE=""
OPT_VAR=""

if echo "$CORE_SOLVE" | grep -qE '^satisfy[[:space:]]*;'; then
    OPT_TYPE=""
elif echo "$CORE_SOLVE" | grep -qE '^(minimize|maximize)[[:space:]]+'; then
    OPT_TYPE=$(echo "$CORE_SOLVE" \
        | sed -E 's/^(minimize|maximize)[[:space:]]+.*/\1/')

    OPT_VAR=$(echo "$CORE_SOLVE" \
        | sed -E 's/^(minimize|maximize)[[:space:]]+([^;[:space:]]+)[[:space:]]*;.*/\2/')

    [ -n "$OPT_VAR" ] || die "Failed to parse objective variable from solve goal: '$RAW_SOLVE_LINE'"
else
    die "Unrecognized solve goal: '$RAW_SOLVE_LINE'"
fi

# Rewrite solve goal -> satisfy 
sed -E 's/^solve[[:space:]]+.*;/solve satisfy;/' \
    "$INPUT_FZN" > "$WORK_FZN" \
    || die "Failed to rewrite solve goal"

# Ensure OPT_VAR has :: output_var (temporarily)

ADDED_OUTPUT_VAR=0

if [ -n "$OPT_VAR" ]; then
    if ! grep -Eq "^[[:space:]]*var[[:space:]].*:[[:space:]]*$OPT_VAR([[:space:]]*::|[[:space:]]*;).*output_var" "$WORK_FZN"; then
        awk -v v="$OPT_VAR" '
            BEGIN { done = 0 }
            /^[[:space:]]*var[[:space:]].*:[[:space:]]*/ {
                if (done == 0 &&
                    $0 ~ (":[[:space:]]*" v "([[:space:]]*::|[[:space:]]*;)")) {

                    if ($0 !~ /::[[:space:]]*output_var/) {
                        sub(/[[:space:]]*;[[:space:]]*$/,
                            " :: output_var;")
                        done = 1
                    }
                }
            }
            { print }
        ' "$WORK_FZN" > "${WORK_FZN}.tmp" \
            || die "Failed to add :: output_var to $OPT_VAR"

        mv "${WORK_FZN}.tmp" "$WORK_FZN"
        ADDED_OUTPUT_VAR=1
    fi
fi

# Linear search

BEST_VALUE=""
FIRST_RUN=1
OPT_MAP="${INPUT_DIR}/${INPUT_BASE}.optmap"
BASE_CNF="${INPUT_DIR}/${INPUT_BASE}.base.cnf"
BASE_BODY="${INPUT_DIR}/${INPUT_BASE}.base.body.cnf"
CURRENT_BOUND_LIT=""

declare -A ORDER_LIT
declare -A ASSIGN_TRUE
ALLOWED_VALUES=()
OBJ_LOWER=""
OBJ_UPPER=""
BASE_VARS=""
BASE_CLAUSES=""

load_optimization_metadata() {
    local key
    local value
    local lit

    while read -r key value lit; do
        case "$key" in
            lower) OBJ_LOWER="$value" ;;
            upper) OBJ_UPPER="$value" ;;
            dimacs_vars) BASE_VARS="$value" ;;
            clauses) BASE_CLAUSES="$value" ;;
            allowed) ALLOWED_VALUES+=("$value") ;;
            order) ORDER_LIT["$value"]="$lit" ;;
        esac
    done < "$OPT_MAP"

    [ -n "$OBJ_LOWER" ] || die "Missing objective lower bound in $OPT_MAP"
    [ -n "$OBJ_UPPER" ] || die "Missing objective upper bound in $OPT_MAP"
    [ -n "$BASE_VARS" ] || die "Missing DIMACS variable count in $OPT_MAP"
    [ -n "$BASE_CLAUSES" ] || die "Missing base clause count in $OPT_MAP"
    [ "${#ALLOWED_VALUES[@]}" -gt 0 ] || die "Missing objective allowed values in $OPT_MAP"
}

literal_for_le_bound() {
    local bound=$1

    if [ "$bound" -ge "$OBJ_UPPER" ]; then
        echo "NONE"
    elif [ "$bound" -lt "$OBJ_LOWER" ]; then
        echo "UNSAT"
    else
        [ -n "${ORDER_LIT[$bound]:-}" ] || die "No order literal for $OPT_VAR <= $bound"
        echo "${ORDER_LIT[$bound]}"
    fi
}

strict_bound_literal() {
    local value=$1

    if [ "$OPT_TYPE" = "minimize" ]; then
        literal_for_le_bound "$((value - 1))"
    elif [ "$OPT_TYPE" = "maximize" ]; then
        if [ "$value" -ge "$OBJ_UPPER" ]; then
            echo "UNSAT"
        elif [ "$value" -lt "$OBJ_LOWER" ]; then
            echo "NONE"
        else
            [ -n "${ORDER_LIT[$value]:-}" ] || die "No order literal for $OPT_VAR <= $value"
            echo "-${ORDER_LIT[$value]}"
        fi
    else
        echo "NONE"
    fi
}

write_incremental_formula() {
    local bound_lit=$1
    local extra_clauses=0

    if [ "$bound_lit" != "NONE" ]; then
        extra_clauses=1
    fi

    {
        echo "p cnf $BASE_VARS $((BASE_CLAUSES + extra_clauses))"
        cat "$BASE_BODY"
        if [ "$bound_lit" != "NONE" ]; then
            echo "$bound_lit 0"
        fi
    } > formula.cnf
}

run_incremental_solver() {
    local bound_lit=$1
    local solver_status

    if [ "$bound_lit" = "UNSAT" ]; then
        echo "UNSAT" > model.out
        return
    fi

    write_incremental_formula "$bound_lit"
    set +e
    cadical -q formula.cnf | cut -c2- > model.out
    solver_status=$?
    set -e

    if [ "$solver_status" -ne 0 ] && [ "$solver_status" -ne 10 ] && [ "$solver_status" -ne 20 ]; then
        return "$solver_status"
    fi
}

load_assignment() {
    local token

    ASSIGN_TRUE=()
    while read -r -a tokens; do
        for token in "${tokens[@]}"; do
            if [[ "$token" =~ ^-?[0-9]+$ ]] && [ "$token" -gt 0 ]; then
                ASSIGN_TRUE["$token"]=1
            fi
        done
    done < model.out
}

objective_from_assignment() {
    local value
    local lit

    load_assignment
    for value in "${ALLOWED_VALUES[@]}"; do
        lit="${ORDER_LIT[$value]:-}"
        if [ -n "$lit" ] && [ -n "${ASSIGN_TRUE[$lit]:-}" ]; then
            echo "$value"
            return
        fi
    done

    return 1
}

normalize_status() {
    local status
    status=$(echo "$1" | xargs)

    case "$status" in
        SAT|SATISFIABLE) echo "SAT" ;;
        UNSAT|UNSATISFIABLE) echo "UNSAT" ;;
        *) echo "$status" ;;
    esac
}

SOLVER_OUTPUT=$(./flatzinc_to_sat -opt-var="$OPT_VAR" -opt-map="$OPT_MAP" "$WORK_FZN") \
    || die "Solver failed on $WORK_FZN"

[ -f formula.cnf ] || die "Expected formula.cnf after base encoding"
cp formula.cnf "$BASE_CNF"
tail -n +2 "$BASE_CNF" > "$BASE_BODY"
load_optimization_metadata

while true; do
    if [ "$FIRST_RUN" -eq 0 ]; then
        run_incremental_solver "$CURRENT_BOUND_LIT" \
            || die "Solver failed on incremental bound"
        STATUS=$(normalize_status "$(head -n 1 model.out)")
    else
        STATUS=$(normalize_status "$(printf "%s\n" "$SOLVER_OUTPUT" | head -n 1)")
    fi


    if [ "$STATUS" = "UNSAT" ]; then
    	if [ "$FIRST_RUN" -eq 1 ]; then

			echo "UNSAT"

	        if [ "$EXPORT_PROOF" -eq 1 ]; then
                rm -rf proofs proofs_step1

                ./flatzinc_to_sat -export-proof "$WORK_FZN" >/dev/null \
                    || die "Solver failed while exporting UNSAT proof (initial)"

                [ -d proofs ] || die "Expected proofs folder not created (initial UNSAT)"

                rm -rf proofs_unsat
                mv proofs proofs_unsat

                if [ -d proofs_step1 ]; then
                    rm -rf proofs_step1_unsat
                    mv proofs_step1 proofs_step1_unsat
                fi

            fi

			exit 0
        fi
        break
    fi

    [ "$STATUS" = "SAT" ] || die "Unexpected solver status: '$STATUS'"

    if [ "$FIRST_RUN" -eq 1 ]; then
        CUR_VALUE=$(printf "%s\n" "$SOLVER_OUTPUT" \
            | grep -E "^${OPT_VAR}[[:space:]]*=" \
            | sed -E "s/^${OPT_VAR}[[:space:]]*=[[:space:]]*([^;[:space:]]+).*/\1/")
    else
        CUR_VALUE=$(objective_from_assignment) \
            || die "Objective variable '$OPT_VAR' could not be decoded from SAT assignment"
    fi

    [ -n "$CUR_VALUE" ] || die "Objective variable '$OPT_VAR' not found in solver output"

    BEST_VALUE="$CUR_VALUE"
    FIRST_RUN=0

    if [ "$OPT_TYPE" = "maximize" ]; then
        NEW_CONSTRAINT="constraint int_lt(${BEST_VALUE}, ${OPT_VAR}) :: ${BOUND_ANN};"
    elif [ "$OPT_TYPE" = "minimize" ]; then
        NEW_CONSTRAINT="constraint int_lt(${OPT_VAR}, ${BEST_VALUE}) :: ${BOUND_ANN};"
    else
        break
    fi

    awk -v c="$NEW_CONSTRAINT" -v ann="$BOUND_ANN" '
        $0 ~ "::[[:space:]]*" ann { next }
        /^solve[[:space:]]+satisfy[[:space:]]*;/ { print c }
        { print }
    ' "$WORK_FZN" > "${WORK_FZN}.tmp" \
        || die "Failed to inject bound constraint"

    mv "${WORK_FZN}.tmp" "$WORK_FZN"
    CURRENT_BOUND_LIT=$(strict_bound_literal "$BEST_VALUE")
done

if [ "$EXPORT_PROOF" -eq 1 ]; then
    rm -rf proofs proofs_step1

    ./flatzinc_to_sat -export-proof "$WORK_FZN" >/dev/null \
        || die "Solver failed while exporting optimality UNSAT proof"

    [ -d proofs ] || die "Expected proofs folder not created (optimality UNSAT)"

    rm -rf proofs_unsat
    mv proofs proofs_unsat

    if [ -d proofs_step1 ]; then
        rm -rf proofs_step1_unsat
        mv proofs_step1 proofs_step1_unsat
    fi
fi

# Replace bound with equality

[ -n "$BEST_VALUE" ] || die "Internal error: BEST_VALUE is empty"

EQ_CONSTRAINT="constraint int_eq(${OPT_VAR}, ${BEST_VALUE}) :: ${BOUND_ANN};"

awk -v c="$EQ_CONSTRAINT" -v ann="$BOUND_ANN" '
    $0 ~ "::[[:space:]]*" ann { print c; next }
    { print }
' "$WORK_FZN" > "${WORK_FZN}.tmp" \
    || die "Failed to replace bound with equality constraint"

mv "${WORK_FZN}.tmp" "$WORK_FZN"

# Remove :: output_var before final SAT 

if [ "$ADDED_OUTPUT_VAR" -eq 1 ]; then
    awk -v v="$OPT_VAR" '
        /^[[:space:]]*var[[:space:]].*:[[:space:]]*/ {
            if ($0 ~ (":[[:space:]]*" v "([[:space:]]*::|[[:space:]]*;)")) {
                gsub(/[[:space:]]*::[[:space:]]*output_var/, "")
            }
        }
        { print }
    ' "$WORK_FZN" > "${WORK_FZN}.tmp" \
        || die "Failed to remove :: output_var from $OPT_VAR"

    mv "${WORK_FZN}.tmp" "$WORK_FZN"
fi


# Final solve / proof export

if [ "$EXPORT_PROOF" -eq 1 ]; then
    rm -rf proofs proofs_step1

    FINAL_OUTPUT=$(./flatzinc_to_sat -export-proof "$WORK_FZN") \
        || die "Solver failed while exporting SAT proof"

    [ -d proofs ] || die "Expected proofs folder not created (SAT)"

    rm -rf proofs_sat
    mv proofs proofs_sat

    if [ -d proofs_step1 ]; then
        rm -rf proofs_step1_sat
        mv proofs_step1 proofs_step1_sat
    fi
else
    FINAL_OUTPUT=$(./flatzinc_to_sat "$WORK_FZN") \
        || die "Solver failed while exporting SAT proof"
fi

# Output

printf "%s\n" "$FINAL_OUTPUT"
